# LifeOS Environment Configuration Example
# Copy this to .env and change values for production

POSTGRES_USER=lifeos_prod_user
POSTGRES_PASSWORD=secure_database_password
POSTGRES_DB=lifeos_production

JWT_SECRET_KEY=generate_a_strong_random_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Internal network URLs (Docker)
ML_SERVICE_URL=http://ml-service:8001
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
